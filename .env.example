# Database (Vercel Postgres / Neon). Copy the value from your Vercel project.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Auth
JWT_SECRET=replace-with-a-long-random-string
VERIFICATION_CODE_SECRET=replace-with-another-long-random-string

# AI model provider (DashScope)
Tongyiqianwen_API_KEY=sk-xxxxxxxxxxxxxxxx

# Aliyun DirectMail (verification emails)
ACCESS_KEY_ID=
ACCESS_KEY_SECRET=
FROM_ALIAS=
ACCOUNT_NAME=
REPLY_ADDRESS=

# Optional: return detailed AI error payloads
DEBUG_API_ERRORS=0
